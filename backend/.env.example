# VoiceKisan Configuration
# Gnani AI Credentials
GNANI_API_KEY=your_gnani_api_key_here
GNANI_PRISMA_STT_URL=https://api.gnani.ai/stt/v1/recognize
GNANI_TIMBRE_TTS_URL=https://api.gnani.ai/tts/v1/synthesize

# Evon Reasoning Model (HuggingFace Inference Endpoint / OpenAI-compatible endpoint)
